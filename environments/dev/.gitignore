# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform plan files
*.tfplan
*.plan
tfplan

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.auto.tfvars
*.auto.tfvars.json

# Local secret variable files
secret.tfvars
secrets.tfvars
credentials.tfvars

# Terraform CLI configuration
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock file - KEEP THIS FILE, so do NOT ignore it
# .terraform.lock.hcl

# OS files
.DS_Store
Thumbs.db

# VS Code settings
.vscode/

# Logs
*.log

# Real environment variable files
environments/*/terraform.tfvars